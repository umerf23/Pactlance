{
  "name": "pactlance",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "check": "npm run check:secrets && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "test:program": "cargo test --manifest-path contracts/Cargo.toml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:escrow": "vitest run integration",
    "devnet:preflight": "node --env-file-if-exists=.env.local scripts/devnet-preflight.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker-loop.mjs",
    "deploy:devnet": "node --env-file-if-exists=.env.local scripts/deploy-devnet.mjs",
    "upgrade:pap:devnet": "node --env-file-if-exists=.env.local scripts/upgrade-pap-devnet.mjs",
    "mint:test": "node --env-file-if-exists=.env.local scripts/mint-test-tokens.mjs",
    "test:pap:devnet": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run devnet/pap-payments.test.ts",
    "test:devnet": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run devnet/workflow.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deployment": "node --env-file-if-exists=.env.local scripts/check-deployment.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:init": "node scripts/release-record.mjs init",
    "release:assess": "node scripts/release-record.mjs assess",
    "release:attach": "node scripts/release-record.mjs attach"
  },
  "dependencies": {
    "@anchor-lang/core": "0.32.2",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/web3.js": "1.99.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tweetnacl": "1.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "litesvm": "1.5.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
