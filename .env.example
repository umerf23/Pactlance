# Phase 2 runs without credentials. Copy to .env.local when configuring Phase 3.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Set only after an actual devnet deployment.
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_TEST_TOKEN_MINT=
