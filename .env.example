# Copy to .env.local for the Phase 3 authenticated workspace.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only needed when no publishable key is supplied.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Set only after an actual devnet deployment.
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_TEST_TOKEN_MINT=

# Optional private devnet RPC for server reconciliation.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Server-only scheduler token: at least 32 random characters.
CRON_SECRET=
# Server-only devnet fee payer (base58 or JSON key bytes); omit for manual claims.
CLAIM_WORKER_SECRET_KEY=
WORKER_APP_URL=http://127.0.0.1:3000
# Local keypair paths. Never commit private keys or share them in chat.
DEPLOYER_KEYPAIR=
MINT_AUTHORITY_KEYPAIR=
# Optional separate transport for the deployment CLI; must also be devnet.
DEPLOY_CLI_RPC_URL=
