# Copy to .env.local for the Phase 3 authenticated workspace.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only needed when no publishable key is supplied.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Set only after an actual devnet deployment.
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_TEST_TOKEN_MINT=
